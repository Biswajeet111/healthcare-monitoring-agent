# ==============================================================================
# HealthGuard AI — Backend Environment Variables Example (NO SECRETS)
# Copy to `.env` for local development or configure in your cloud host dashboard.
# ==============================================================================

# --- Application ---
APP_NAME=HealthGuard AI
APP_VERSION=1.0.0
DEBUG=false

# --- Security (REQUIRED — generate a strong random secret, e.g. `openssl rand -hex 32`) ---
JWT_SECRET_KEY=replace_with_strong_random_jwt_secret

# --- Experimental Diabetes Model v3 Integrity Check (64-char SHA-256 of models/diabetes_v3_candidate/pipeline.joblib) ---
DIABETES_V3_SHA256=replace_with_64_char_sha256_checksum

# --- Database ---
# Local development (SQLite):
DATABASE_URL=sqlite:///./healthguard.db
# Cloud deployment (PostgreSQL — Neon / Supabase / Render Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- LLM Provider Selection ---
# Use "ollama" for local development or "groq" for cloud deployment
LLM_PROVIDER=ollama

# Local Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1

# Groq cloud inference settings (used when LLM_PROVIDER=groq)
# Note: Verify available models on your Groq account (`qwen/qwen3.8-27b` or `openai/gpt-oss-20b` currently active)
GROQ_API_KEY=replace_with_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Privacy guard for cloud LLM:
# Keep "false" if handling real patient data; set "true" for synthetic CSE472 evaluation accounts only.
ALLOW_CLOUD_PERSONAL_DATA=false

# --- Embeddings & Persistent Storage Paths ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_LOCAL_FILES_ONLY=false
VECTOR_DB_PATH=./data/vector_db
UPLOAD_DIR=./storage/medical_reports

# --- CORS (comma-separated allowed frontend origins, no trailing slash) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for Vercel preview URLs:
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# --- Background Reminder Worker ---
ENABLE_REMINDER_WORKER=true
