# ==============================================================================
# HealthGuard AI — Frontend Environment Variables Example (NO SECRETS)
# Never put GROQ_API_KEY, JWT_SECRET_KEY, or DATABASE_URL in VITE_* variables!
# ==============================================================================

# --- Option A: Lightweight Vercel Hobby Educational Demo (Synthetic Data) ---
# Set VITE_DEMO_MODE=true in Vercel Project Settings (leave VITE_API_BASE_URL empty).
# Set GROQ_API_KEY (without VITE_ prefix!) as a Server-Side Environment Variable in Vercel
# so /api/assistant works securely without exposing the key to the browser.
VITE_DEMO_MODE=true

# --- Option B: Full-Stack Mode (Connected to Local or Cloud FastAPI Backend) ---
# VITE_DEMO_MODE=false
# VITE_API_BASE_URL=http://127.0.0.1:8000
